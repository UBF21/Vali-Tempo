<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Package identity -->
        <PackageId>Vali-Tempo</PackageId>
        <Title>Vali-Tempo</Title>
        <Product>Vali-Tempo</Product>
        <Version>1.1.0</Version>
        <Authors>Felipe Rafael Montenegro Morriberon</Authors>
        <Copyright>Copyright © 2025 - FM. All rights reserved.</Copyright>

        <!-- Repository -->
        <RepositoryUrl>https://github.com/UBF21/Vali-Tempo</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://vali-tempo-docs.netlify.app/docs/introduction</PackageProjectUrl>

        <!-- License -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

        <!-- Discoverability -->
        <PackageTags>vali;vali-tempo;time;date;calendar;holiday;schedule;range;age;countdown;timezone;dotnet</PackageTags>
        <PackageIcon>VT.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- Source Link / Symbols -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>embedded</DebugType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <Description>Vali-Tempo is the all-in-one meta-package for the Vali-Tempo ecosystem. Installing it gives you every module — Vali-Time, Vali-Range, Vali-Calendar, Vali-CountDown, Vali-Age, Vali-Holiday, Vali-TimeZone, Vali-Schedule, Vali-Duration, Vali-BusinessHours, and Vali-Bucket — with a single NuGet reference and a single DI registration call.</Description>
        <PackageReleaseNotes>Vali-Tempo v1.1.0 — add Vali-BusinessHours and Vali-Bucket to the meta-package registration (temporarily via ProjectReference until both are published; see ponytail comment below). No breaking changes.

            Vali-Tempo v1.0.0 — meta-package for the Vali-Tempo ecosystem. Registers all Vali services via AddValiTempo().</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <!-- Pinned at the versions already published on nuget.org. AddValiTempo() only forwards to
             each package's own AddValiX() extension method, which already exists at these versions,
             so it doesn't need any of the new members those packages add in this release. Bump
             these pins to the new versions in a follow-up PR, once each one is actually published
             (see CONTRIBUTING.md's Release Process). -->
        <PackageReference Include="Vali-Time" Version="1.0.1" />
        <PackageReference Include="Vali-Range" Version="1.0.0" />
        <PackageReference Include="Vali-Calendar" Version="1.0.0" />
        <PackageReference Include="Vali-CountDown" Version="1.0.0" />
        <PackageReference Include="Vali-Age" Version="1.0.0" />
        <PackageReference Include="Vali-Holiday" Version="1.0.0" />
        <PackageReference Include="Vali-TimeZone" Version="1.0.0" />
        <PackageReference Include="Vali-Schedule" Version="1.0.0" />
        <PackageReference Include="Vali-Duration" Version="1.0.0" />
    </ItemGroup>

    <ItemGroup>
        <!-- ponytail: ProjectReference instead of PackageReference — neither package has been
             published to NuGet yet. Switch to a pinned PackageReference once they are. -->
        <ProjectReference Include="..\Vali-BusinessHours\Vali-BusinessHours.csproj" />
        <ProjectReference Include="..\Vali-Bucket\Vali-Bucket.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="VT.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>
